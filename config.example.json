{
  "mode": "once",
  "server_name": "Lab-Server-01",
  "check_interval_minutes": 20,
  "idle_consecutive_hits": 3,
  "idle_notify_max_count": 3,
  "cooldown_minutes": 30,
  "notify": {
    "providers": [
      {
        "type": "serverchan",
        "send_key": ""
      },
      {
        "type": "feishu",
        "webhook": ""
      }
    ]
  },
  "job": {
    "enabled": false,
    "command": "bash run.sh",
    "working_dir": ".",
    "gpus": [],
    "cooldown_minutes": 60,
    "timeout_seconds": 0,
    "notify_on_start": true,
    "notify_on_finish": true,
    "run_once_per_idle": true,
    "log_dir": "./runtime/jobs"
  }
}
